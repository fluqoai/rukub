# CJdropshipping (اختياري للـ scaffold — mock mode يعمل بدونه)
# CJ_API_KEY=
# CJ_EMAIL=

# Tap Payments (فعّلها فقط بعد اعتماد الحساب)
# Test mode: sk_test_...
# Live mode: sk_live_...
# TAP_SECRET_KEY=

# Email (Resend) — mock mode يعمل بدونه
# Get free API key at https://resend.com
# RESEND_API_KEY=
# FROM_EMAIL=orders@rukub.sa
# REPLY_TO=support@rukub.sa

# Public app URL (للـ redirects في Tap)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Store identity (only verified values are shown publicly)
# NEXT_PUBLIC_STORE_EMAIL=support@your-domain.com
# NEXT_PUBLIC_STORE_PHONE=9665XXXXXXXX

# Arabic product drafts (server-only)
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-plus
AI_MAX_GENERATIONS=100

# Local management only: never deploy these credentials to the website runtime.
# VERCEL_TOKEN=
# DATABASE_URL=
