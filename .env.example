# CJdropshipping (اختياري للـ scaffold — mock mode يعمل بدونه)
# CJ_API_KEY=
# CJ_EMAIL=

# Tap Payments (اختياري — mock mode يعمل بدونه)
# Test mode: sk_test_...
# Live mode: sk_live_...
# TAP_SECRET_KEY=

# Tabby (اختياري — mock UI يعمل بدونه)
# TABBY_PUBLIC_KEY=
# TABBY_SECRET_KEY=

# Email (Resend) — mock mode يعمل بدونه
# Get free API key at https://resend.com
# RESEND_API_KEY=
# FROM_EMAIL=orders@rukub.sa
# REPLY_TO=support@rukub.sa

# WhatsApp Business API (Meta Cloud API) — mock mode يعمل بدونه
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_ID=

# Public app URL (للـ redirects في Tap)
# NEXT_PUBLIC_APP_URL=https://your-domain.com
